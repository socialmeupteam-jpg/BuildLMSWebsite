# =============================================================================
# SocialMeUp Academy LMS — Environment Variables Template
# Copy this file to .env and configure with appropriate environment credentials.
# NEVER commit .env or actual production credentials to version control.
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=/api

# Supabase Public Configuration (Accessible in client via VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Server-Only Privileged Configuration (NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT & Authentication Secret
JWT_SECRET=your-super-secret-jwt-signing-key-minimum-32-chars

# Razorpay Payment Gateway (Server-side)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email / SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
EMAIL_FROM=admissions@socialmeupacademy.in

# Storage (Supabase Storage / Cloudinary if used)
STORAGE_BUCKET_NAME=lms-academy-assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
